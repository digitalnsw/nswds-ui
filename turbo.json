{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalEnv": [
    "NODE_ENV",
    "REGISTRY_LOCATION",
    "REGISTRY_ORIGIN",
    "INFOGRAPHICS_ORIGIN",
    "STORYBOOK_ORIGIN",
    "VERCEL_ENV"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "SIGNUP_ALLOWED_EMAILS",
    "NSWDS_AUTH_GATE",
    "VERCEL",
    "VERCEL_URL",
    "VERCEL_BRANCH_URL"
  ],
  "globalDependencies": [".env", "registry.config.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "storybook-static/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "registry:build": {
      "dependsOn": ["@nswds/ui#build"],
      "inputs": ["registry.json", "components.json", "scripts/**", "src/**"],
      "outputs": ["../../apps/registry/public/r/**"]
    },
    "registry:validate": {
      "inputs": ["registry.json"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
