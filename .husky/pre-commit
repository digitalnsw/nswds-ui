#!/usr/bin/env sh
# src/icons/ is GENERATED by packages/ui/scripts/generate-icons.mjs but committed
# to the tree, so an editor "Sort Lines" (or hand-edit) can silently reorder the
# barrel. The CI parity check is order-independent on its own; the strengthened
# `check` verifies the canonical form. Run it here only when icon files are
# actually staged, so non-icon commits pay nothing.
if git diff --cached --name-only | grep -q '^packages/ui/src/icons/'; then
  echo "icons/ changed — verifying generated barrel is canonical…"
  npm run check:icons -w @nswds/ui || {
    echo "✗ icons drift detected. Run 'node scripts/generate-icons.mjs index' in packages/ui, then re-stage src/icons/." >&2
    exit 1
  }
fi
