{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@storybook/react-vite": [
        "./node_modules/@storybook/react-vite/dist/index.d.ts"
      ],
      "storybook/test": [
        "./node_modules/storybook/dist/test/index.d.ts"
      ],
      "storybook/preview-api": [
        "./node_modules/storybook/dist/preview-api/index.d.ts"
      ],
      "storybook/manager-api": [
        "./node_modules/storybook/dist/manager-api/index.d.ts"
      ],
      "@nswds/ui/globals.css": ["../../packages/ui/src/styles/globals.css"],
      "@nswds/ui/postcss.config": ["../../packages/ui/postcss.config.mjs"],
      "@nswds/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/ui/src/**/*.stories.ts",
    "../../packages/ui/src/**/*.stories.tsx"
  ],
  "exclude": ["node_modules", "storybook-static"]
}
