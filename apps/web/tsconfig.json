{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@nswds/ui/globals.css": [
        "../../packages/ui/src/styles/globals.css.d.ts"
      ],
      "@nswds/ui/postcss.config": ["../../packages/ui/postcss.config.mjs"],
      "@nswds/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
