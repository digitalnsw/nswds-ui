{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "NSWDS Theme",
  "description": "NSW Government semantic design tokens — maps the shadcn token names onto the @nswds/tokens palette for light and dark mode.",
  "dependencies": [
    "@nswds/tokens"
  ],
  "cssVars": {
    "theme": {
      "font-heading": "var(--font-sans)"
    },
    "light": {
      "white": "oklch(1 0 0)",
      "background": "var(--white)",
      "foreground": "var(--grey-800)",
      "card": "var(--white)",
      "card-foreground": "var(--grey-800)",
      "popover": "var(--white)",
      "popover-foreground": "var(--grey-800)",
      "primary": "var(--primary-800)",
      "primary-foreground": "var(--primary-50)",
      "secondary": "var(--grey-100)",
      "secondary-foreground": "var(--grey-800)",
      "muted": "var(--grey-100)",
      "muted-foreground": "var(--grey-550)",
      "accent": "var(--grey-100)",
      "accent-foreground": "var(--grey-800)",
      "destructive": "var(--danger-500)",
      "border": "var(--grey-250)",
      "input": "var(--grey-250)",
      "ring": "var(--grey-450)",
      "chart-1": "var(--primary-450)",
      "chart-2": "var(--primary-550)",
      "chart-3": "var(--primary-600)",
      "chart-4": "var(--primary-650)",
      "chart-5": "var(--primary-700)",
      "radius": "0.45rem",
      "sidebar": "var(--grey-50)",
      "sidebar-foreground": "var(--grey-800)",
      "sidebar-primary": "var(--primary-600)",
      "sidebar-primary-foreground": "var(--primary-50)",
      "sidebar-accent": "var(--grey-100)",
      "sidebar-accent-foreground": "var(--grey-800)",
      "sidebar-border": "var(--grey-250)",
      "sidebar-ring": "var(--grey-450)",
      "input-border": "var(--grey-600)",
      "input-foreground": "var(--grey-800)",
      "input-placeholder": "var(--grey-500)",
      "input-surface": "var(--background)",
      "input-surface-hover": "var(--grey-100)",
      "input-ring": "var(--grey-600)",
      "input-invalid-border": "var(--danger-600)",
      "input-invalid-surface-hover": "var(--danger-50)",
      "input-invalid-ring": "var(--danger-600)"
    },
    "dark": {
      "background": "var(--grey-950)",
      "foreground": "var(--grey-50)",
      "card": "var(--grey-850)",
      "card-foreground": "var(--grey-50)",
      "popover": "var(--grey-850)",
      "popover-foreground": "var(--grey-50)",
      "primary": "var(--primary-700)",
      "primary-foreground": "var(--primary-50)",
      "secondary": "var(--grey-800)",
      "secondary-foreground": "var(--grey-50)",
      "muted": "var(--grey-800)",
      "muted-foreground": "var(--grey-450)",
      "accent": "var(--grey-800)",
      "accent-foreground": "var(--grey-50)",
      "destructive": "var(--danger-350)",
      "border": "var(--grey-800)",
      "input": "var(--grey-750)",
      "ring": "var(--grey-550)",
      "chart-1": "var(--primary-450)",
      "chart-2": "var(--primary-550)",
      "chart-3": "var(--primary-600)",
      "chart-4": "var(--primary-650)",
      "chart-5": "var(--primary-700)",
      "sidebar": "var(--grey-850)",
      "sidebar-foreground": "var(--grey-50)",
      "sidebar-primary": "var(--primary-550)",
      "sidebar-primary-foreground": "var(--primary-50)",
      "sidebar-accent": "var(--grey-800)",
      "sidebar-accent-foreground": "var(--grey-50)",
      "sidebar-border": "var(--grey-800)",
      "sidebar-ring": "var(--grey-550)",
      "input-border": "var(--grey-100)",
      "input-foreground": "var(--grey-100)",
      "input-placeholder": "var(--grey-300)",
      "input-surface": "color-mix(in oklab, var(--input) 30%, transparent)",
      "input-surface-hover": "color-mix(in oklab, var(--input) 50%, transparent)",
      "input-invalid-border": "var(--danger-200)",
      "input-invalid-surface-hover": "color-mix(in oklab, var(--danger-900) 30%, transparent)",
      "input-invalid-ring": "var(--danger-200)",
      "input-ring": "var(--grey-100)"
    }
  },
  "docs": "Add the @nswds/tokens layers to your Tailwind entry CSS (after `@import \"tailwindcss\";`):\n\n@import \"@nswds/tokens/css/colors/global/oklch.css\";\n@import \"@nswds/tokens/css/colors/semantic/oklch.css\";\n@import \"@nswds/tokens/css/colors/themes/masterbrand/oklch.css\";\n@import \"@nswds/tokens/tailwind/colors/global/oklch.css\";\n@import \"@nswds/tokens/tailwind/colors/themes/masterbrand/oklch.css\";\n@import \"@nswds/tokens/tailwind/colors/semantic/oklch.css\";\n\nSee https://github.com/digitalnsw/nswds-ui/blob/main/docs/installing-from-the-registry.md",
  "type": "registry:theme",
  "meta": {
    "nswdsVersion": "3.1.0"
  }
}
