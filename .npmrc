# Synced from digitalnsw/nswds-devops — DO NOT EDIT in this repo.
# nswds-ui variant: the canonical repo-files/.npmrc does NOT apply here.
#
# provenance attestation is intentionally OFF: npm only supports provenance
# for PUBLIC source repositories, and this repo is private — with it enabled,
# every publish fails with E422 ("Unsupported GitHub Actions source repository
# visibility: private"), which silently stranded v1.8.0–v2.1.0 as git tags
# that never reached npm. Re-enable if the repo is ever made public.
provenance=false

# engine-strict matches the rest of the fleet. Note that it applies to EVERY
# installed package, not just the workspace ones: any dependency — however
# deep — whose engines field excludes the running Node is a hard EBADENGINE
# install failure, not a warning.
#
# That makes the effective floor the strictest engines range in the whole
# tree, which is currently ^22.22.2 || >=24.15.0, set by @nswds/tokens and by
# @semantic-release/{changelog,git}. The root engines range is kept in sync
# with that floor so `npm ci` cannot fail on a Node version the repo claims to
# support. .nvmrc's 24.16.0 — which ships npm 11.13.0 — satisfies it.
#
# packages/ui deliberately keeps the wider ^22.14.0 || >=24.10.0: it is the
# PUBLISHED package, none of the packages imposing the floor are runtime
# dependencies of it (@nswds/tokens is a devDependency, inlined into
# dist/styles.css at build time), so consumers are not affected and must not
# be narrowed.
engine-strict=true
