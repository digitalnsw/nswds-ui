{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@nswds/ui/globals.css": ["./src/styles/globals.css"],
      "@nswds/ui/components/*": ["./src/components/*.tsx"],
      "@nswds/ui/hooks/*": ["./src/hooks/*.ts"],
      "@nswds/ui/lib/*": ["./src/lib/*.ts"],
      "@nswds/ui/postcss.config": ["./postcss.config.mjs"],
      "@nswds/ui/*": ["./src/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist", "**/*.stories.tsx", "**/*.stories.ts"]
}
